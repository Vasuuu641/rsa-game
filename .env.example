# Copy to .env and adjust if you're running services outside Docker Compose.
# When using docker-compose.yml as-is, these are already set per-service
# and you don't need this file locally.

DATABASE_URL=postgresql+asyncpg://rsagame:rsagame@localhost/rsagame
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-secret-change-me

AUTH_SERVICE_URL=http://localhost:8001
MATCH_SERVICE_URL=http://localhost:8002
CRYPTO_SERVICE_URL=http://localhost:8003
STATS_SERVICE_URL=http://localhost:8004
